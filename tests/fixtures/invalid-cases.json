{
  "_readme": "校验规则用例。data 为『规范化之后』的形状（字符串数值），直接喂给 Core.validate。ok 用例必须零错误，fail 用例断言 errors[0].code 恰为 expect。",
  "ok": [
    {
      "title": "基准合法输入",
      "data": {
        "db": "oracle", "schema": "scott", "table": "emp", "tableDesc": "员工信息表",
        "fields": [{ "name": "emp_no", "desc": "员工编号", "type": "字符型", "length": "20", "precision": "", "scale": "" }],
        "pk": { "name": "pk_emp", "fields": ["emp_no"] },
        "indexes": [{ "name": "idx_emp_01", "fields": ["emp_name"] }]
      }
    },
    {
      "title": "允许无主键",
      "data": {
        "db": "gauss", "schema": "public", "table": "t1", "tableDesc": "表1",
        "fields": [{ "name": "c1", "desc": "列1", "type": "整型", "length": "", "precision": "", "scale": "" }],
        "pk": { "name": "", "fields": [] },
        "indexes": []
      }
    },
    {
      "title": "允许无索引",
      "data": {
        "db": "oracle", "schema": "scott", "table": "t2", "tableDesc": "表2",
        "fields": [
          { "name": "c1", "desc": "列1", "type": "字符型", "length": "1", "precision": "", "scale": "" },
          { "name": "c2", "desc": "列2", "type": "时间戳", "length": "", "precision": "", "scale": "" }
        ],
        "pk": { "name": "pk_t2", "fields": ["c1", "c2"] },
        "indexes": []
      }
    },
    {
      "title": "小数位数为 0 合法（0 < 精度）",
      "data": {
        "db": "oracle", "schema": "scott", "table": "t3", "tableDesc": "表3",
        "fields": [{ "name": "amt", "desc": "金额", "type": "数值型", "length": "", "precision": "10", "scale": "0" }],
        "pk": { "name": "", "fields": [] },
        "indexes": []
      }
    },
    {
      "title": "索引名可自定义（不强制 idx_ 前缀）",
      "data": {
        "db": "oracle", "schema": "scott", "table": "t4", "tableDesc": "表4",
        "fields": [
          { "name": "c1", "desc": "列1", "type": "整型", "length": "", "precision": "", "scale": "" },
          { "name": "c2", "desc": "列2", "type": "整型", "length": "", "precision": "", "scale": "" }
        ],
        "pk": { "name": "pk_t4", "fields": ["c1"] },
        "indexes": [{ "name": "custom_idx", "fields": ["c2"] }]
      }
    },
    {
      "title": "字段名大小写不敏感比较：不重复",
      "data": {
        "db": "oracle", "schema": "scott", "table": "t5", "tableDesc": "表5",
        "fields": [
          { "name": "COL_A", "desc": "列甲", "type": "整型", "length": "", "precision": "", "scale": "" },
          { "name": "col_b", "desc": "列乙", "type": "整型", "length": "", "precision": "", "scale": "" }
        ],
        "pk": { "name": "", "fields": [] },
        "indexes": []
      }
    },
    {
      "title": "唯一索引（indexes[].unique=true）合法",
      "data": {
        "db": "mysql", "schema": "shop", "table": "t9", "tableDesc": "表9",
        "fields": [{ "name": "c1", "desc": "列1", "type": "字符型", "length": "10", "precision": "", "scale": "" }],
        "pk": { "name": "", "fields": [] },
        "indexes": [
          { "name": "uk_t9_01", "unique": true, "fields": ["c1"] },
          { "name": "idx_t9_02", "unique": false, "fields": ["c1"] }
        ]
      }
    }
  ],
  "fail": [
    {
      "title": "顶层不是对象（形状类错误，走 generate 全链）",
      "expect": "E_INPUT_SHAPE",
      "raw": true,
      "data": [1, 2, 3]
    },
    {
      "title": "不支持的数据库（形状类错误，走 generate 全链）",
      "expect": "E_DB_INVALID",
      "raw": true,
      "data": {
        "db": "postgres", "schema": "scott", "table": "emp", "tableDesc": "员工信息表",
        "fields": [{ "name": "", "desc": "列1", "type": "整型", "length": "", "precision": "", "scale": "" }],
        "pk": { "name": "", "fields": [] }, "indexes": []
      }
    },
    {
      "title": "不支持的字段类型（形状类错误，走 generate 全链）",
